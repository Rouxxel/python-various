# Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED (All modes)
# ============================================
API_KEY=change-me-local-dev
FRONTEND_URL=http://localhost:5173
DASHBOARD_BACKEND_HOST=127.0.0.1
DASHBOARD_BACKEND_PORT=8001
LOG_LEVEL=INFO

# Data mode: mock (no external services) or live (requires providers)
DASHBOARD_DATA_MODE=mock

# ============================================
# DATABASE (Supabase - Optional if mock)
# ============================================
# FEATURE_SUPABASE=true
SUPABASE_URL_TEST=
SUPABASE_ANON_KEY_TEST=
SUPABASE_SERVICE_ROLE_KEY_TEST=

SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# ============================================
# FRONTEND HOSTING (Vercel - Optional)
# ============================================
# FEATURE_VERCEL=false
VERCEL_BASE_URL=https://vercel.com
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_URL=

VERCEL_PROJECT_ID_TEST=
VERCEL_PROJECT_NAME_TEST=

VERCEL_PROJECT_ID_PROD=
VERCEL_PROJECT_NAME_PROD=

# ============================================
# BACKEND HOSTING (Render/Railway/Fly - Optional)
# ============================================
# FEATURE_HOST_HEALTH=false
HOSTING_PROVIDER=none  # Options: none, render, railway, fly, custom

# Render
RENDER_SERVICE_URL=

# Railway
RAILWAY_SERVICE_URL=

# Fly.io
FLY_SERVICE_URL=

# Custom
CUSTOM_SERVICE_URL=

# Generic API URLs (for test/prod switch)
MAIN_API_URL_TEST=
MAIN_API_URL_PROD=

# ============================================
# COSTS MODULE (Optional)
# ============================================
# FEATURE_COSTS_MODULE=false

# Generic pricing
COSTS_UNIT_PRICE=0.0
COSTS_UNIT_NAME=
COSTS_CURRENCY=USD

# ============================================
# EXTERNAL PROVIDERS (Optional)
# ============================================
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=

# ============================================
# AUTHENTICATION (Optional)
# ============================================
DASHBOARD_ALLOWED_EMAILS=

# ============================================
# PRIVATE DATABASE (optional — non-Supabase)
# ============================================
# Use when Postgres/MySQL runs on your own server (VPS, LAN, VPN).
# Implement queries in app/services/live/ — see docs/EXTENDING_PROVIDERS.md
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ============================================
# DATADOG (optional — extension, not built-in)
# ============================================
# FEATURE_DATADOG=false
# FEATURE_PRIVATE_DATABASE=false
# DATADOG_API_KEY=
# DATADOG_APP_KEY=
# DATADOG_SITE=datadoghq.com
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ============================================
# FEATURE FLAGS
# ============================================
# Toggle features on/off without changing code
FEATURE_SUPABASE=true
FEATURE_VERCEL=false
FEATURE_HOST_HEALTH=false
FEATURE_STORAGE_METRICS=false
FEATURE_COSTS_MODULE=false
FEATURE_TEST_PROD_SWITCH=true
FEATURE_DATADOG=false
FEATURE_PRIVATE_DATABASE=false
