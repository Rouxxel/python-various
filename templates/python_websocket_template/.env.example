# WebSocket Template Environment Variables
# Copy this file to .env.local for local development

# Server Configuration default
SERVER_PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=1

# Logging
LOG_LEVEL=info

# API Configuration
API_TITLE=WebSocket Template
API_VERSION=1.0.0
API_DESCRIPTION=A template for building WebSocket backends with FastAPI

# Redis (optional — set REDIS_ENABLED=true to activate)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_WS_BROADCAST_CHANNEL=ws:broadcast
