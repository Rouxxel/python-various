{
    "defaults": {
        "general_data_path": "src/core_specs/data/general_data.json"
    },
    "logging": {
        "logging_level": "debug",
        "dir_name": "logs",
        "log_file_name": "x_bcknd"
    },
    "email_validation": {
        "allowed_providers": [
            "gmail",
            "outlook",
            "yahoo",
            "hotmail",
            "icloud",
            "protonmail",
            "aol",
            "zoho",
            "gmx",
            "mail"
        ],
        "allowed_tlds": ["com", "org", "net", "co", "io", "edu", "gov"]
    },
    "network": {
        "uvicorn_app_reference": "main:app",
        "server_port": 8000,
        "host": "0.0.0.0",
        "reload": false,
        "workers": 1,
        "proxy_headers": true
    },
    "endpoints": {
        "root_directory_endpoint": {
            "request_limit": 25,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "",
            "endpoint_tag": "health",
            "endpoint_route": "/"
        },
        "rpc_invoke_procedure": {
            "request_limit": 60,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/rpc",
            "endpoint_tag": "rpc",
            "endpoint_route": "/invoke"
        },
        "rpc_start_agent_run_procedure": {
            "request_limit": 20,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/rpc",
            "endpoint_tag": "agent",
            "endpoint_route": "/startExampleAgentRun"
        },
        "rpc_stream_agent_run_procedure": {
            "request_limit": 120,
            "unit_of_time_for_limit": "m",
            "endpoint_prefix": "/rpc",
            "endpoint_tag": "agent",
            "endpoint_route": "/streamExampleAgentRun"
        }
    }
}
